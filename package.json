{
	"name": "ranked-search",
	"version": "1.0.0",
	"description": "Obsidian search that ranks the closest match first.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test test/*.test.ts",
		"deploy": "npm run build && node deploy.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"overrides": {
		"moment": "^2.31.0"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
